# Veil Project .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
*.egg-info/
dist/
build/

# Node
node_modules/
/.pnp
.pnp.js

# Next.js
.next/
out/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env*.local

# Data (raw dataset — too large for git)
backend/data/raw/*.csv

# Generated training checkpoints and caches
scripts/_distilbert_checkpoint/
*.onnx.data
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/
tmp/
temp/
*.tmp
*.cache

# Models are included in git (tiny: ~130 KB total) so deployment doesn't need to retrain
# backend/models/*.pkl

# Logs
*.log
npm-debug.log*
yarn-debug.log*
